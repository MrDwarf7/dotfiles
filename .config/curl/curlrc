# For config locations:
#
# 1) "$CURL_HOME/.curlrc"
# 2) "$XDG_CONFIG_HOME/curlrc" (Added in 7.73.0)
# 3) "$HOME/.curlrc"
#
# 4) Windows: "%USERPROFILE%\.curlrc"
# 5) Windows: "%APPDATA%\.curlrc"
# 6) Windows: "%USERPROFILE%\Application Data\.curlrc"
# 7) Non-Windows: use getpwuid to find the home directory
# 8) On Windows, if it finds no .curlrc file in the sequence described above, it checks for one in the same directory the curl executable is placed.
# On Windows two filenames are checked per location: .curlrc and _curlrc, preferring the former. Older versions on Windows checked for _curlrc only.

# Follow redirects
location

# When following redirects, automatically set the previous URL as the referrer
referrer = ";auto"

# Do not output anything else escept the actual error message
silent
show-error

# Wait N seconds before timeout
connect-timeout = 10
