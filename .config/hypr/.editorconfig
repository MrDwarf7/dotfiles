root = true


[*]
# Change these settings to your own preference
indent_style = space
indent_size = 2
# We recommend you to keep these unchanged
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true


[*.lua]
indent_style = space
indent_width = 2
column_width = 120
trim_trailing_whitespace = true


[*.conf]
indent_style = space
indent_size = 4


[*.md]
trim_trailing_whitespace = false
