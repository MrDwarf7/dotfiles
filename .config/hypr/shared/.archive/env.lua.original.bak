--############################
--## ENVIRONMENT VARIABLES ###
--############################

--### IF USING uwsm, DON'T LOAD VIA HERE, USE ~/.config/uwsm/

-- See https://wiki.hyprland.org/Configuring/Environment-variables/

-- Toolkit Backend Variables
-- wayland if available, otherwise x11, otherwise fallback to another available backend
-- Generated by hyprlang2lua. Review TODOs before reloading Hyprland.

---@alias EnvVarKey string
---@alias EnvVarValue string|number|boolean

--- Mapping of K : V pairs for Environment Variables to set for Hyprland configuration.
--- This is used because Hyprland is _sometimes_ run without UWSM,
--- The module itself can be loaded idepotently, and will attempt
--- to fill the local struct with existing variables first.
---@generic K:EnvVarKey
---@generic V:EnvVarValue
---@class HyprConfig.Env : table<K, V> A table of environment variables to set, where K is the variable name and V is the variable value.
local envs = {
  -- ["GDK_BACKEND"] = nil,
}

function envs.get(key)
  if type(key) ~= "string" then
    error("Environment variable key must be a string")
  end
  local from_uwsm = os.getenv(key)
  if from_uwsm then
    return from_uwsm
  end
  local value = rawget(envs, key)
  if value == nil then -- no uwsm, no envs table value (yet)
    return nil
  end
  return value
end

--- Sets an environment variable in the `envs` table and also calls `hl.env()` to set it in Hyprland.
---
---@param key EnvVarKey The name of the environment variable to set.
---@param value EnvVarValue The value of the environment variable to set. Must be a string, number, or boolean.
---@return nil|Error
function envs.set(key, value)
  if type(key) ~= "string" then
    error("Environment variable key must be a string")
  end
  if type(value) ~= "string" and type(value) ~= "number" and type(value) ~= "boolean" then
    error("Environment variable value must be a string, number, or boolean")
  end
  local nk, nv
  local mv = rawget(envs, key)
  local maybe_v = envs.get(key)

  if mv ~= nil and mv ~= value then
    nk, nv = key, value
  elseif maybe_v == nil then
    nk, nv = key, value
  else
    nk, nv = key, maybe_v
  end

  rawset(envs, nk, nv)
  return hl.env(nk, nv)

  -- if maybe_v ~= nil then
  --   rawset(envs, key, maybe_v)
  -- end
  -- rawset(envs, key, value)
  --
  -- local kv = rawget(envs, key)
end

setmetatable(envs, {
  __index = function(t, key)
    return rawget(t, key)
  end,
  __newindex = function(_, key, value)
    envs.set(key, value)
  end,
})

local setup_envs = function()
  local fallbacks = {
    -- Toolkit Backend Variables
    ["GDK_BACKEND"] = "wayland,x11",
    ["QT_QPA_PLATFORM"] = "wayland",
    ["SDL_VIDEODRIVER"] = "wayland",
    ["CLUTTER_BACKEND"] = "wayland",

    -- XDG Specifications
    ["XDG_CURRENT_DESKTOP"] = "Hyprland",
    ["XDG_SESSION_TYPE"] = "wayland",
    ["XDG_SESSION_DESKTOP"] = "Hyprland",

    -- Qt Variables
    ["QT_AUTO_SCREEN_SCALE_FACTOR"] = 1,
    ["QT_WAYLAND_DISABLE_WINDOWDECORATION"] = 1,
    ["QT_QPA_PLATFORMTHEME"] = "hyprqt6engine,qt6ct",

    -- NVIDIA Specific
    ["GBM_BACKEND"] = "nvidia-drm",
    ["__GLX_VENDOR_LIBRARY_NAME"] = "nvidia",
    ["LIBVA_DRIVER_NAME"] = "nvidia",
    ["__GL_GSYNC_ALLOWED"] = 1,
    ["__GL_VRR_ALLOWED"] = 0,

    -- Themeing Related Variables
    ["GTK_THEME"] = "Tokyonight-Dark-B",
    ["HYPRCURSOR_THEME"] = "Hyprcursor-Bibata-Modern-Classic",
    ["HYPRCURSOR_SIZE"] = 24,
    ["XCURSOR_THEME"] = "Bibata-Modern-Classic",
    ["XCURSOR_SIZE"] = 24,

    -- Other
    ["WLR_RENDERER_ALLOW_SOFTWARE"] = 1,
    ["WLR_NO_HARDWARE_CURSORS"] = 1,
    ["NVD_BACKEND"] = "direct",
    ["ELECTRON_OZONE_PLATFORM_HINT"] = "wayland",

    ["WEBKIT_DISABLE_DMABUF_RENDERER"] = 1,

    ["MOZ_ENABLE_WAYLAND"] = 1,

    ["WALLPAPER_BACKEND"] = "wallpaperengine",
    ["HYPRLAND_SHELL"] = "dms",
  }
  setmetatable(fallbacks, {
    __index = function(t, key)
      return rawget(t, key)
    end,
  })

  -- local is_uwsm = os.getenv("UWSM_FINALIZE_VARNAMES") or os.getenv("UWSM_WAIT_VARNAMES")
  -- 1) IF we ARE in uwsm:
  --    yield values (uwsm takes prio) - ONLY setting something if it's not ALREADY set.
  --    Fill in the envs table with existing values (from uwsm) or fallbacks if not set (envs.{set,get} already handle this internally)
  --
  -- 2) IF we are NOT in uwsm:
  --    set the envs table with fallbacks (envs.{set,get} already

  for k, v in pairs(fallbacks) do
    envs.set(k, v)
  end
end

setup_envs()

