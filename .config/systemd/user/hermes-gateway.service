[Unit]
Description=Hermes Agent Gateway - Messaging Platform Integration
After=network.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/home/dwarf/Documents/GitHub_Projects/Python/OTHER/hermes-agent/.venv/bin/python -m hermes_cli.main gateway run --replace
WorkingDirectory=/home/dwarf/Documents/GitHub_Projects/Python/OTHER/hermes-agent
Environment="PATH=/home/dwarf/Documents/GitHub_Projects/Python/OTHER/hermes-agent/.venv/bin:/home/dwarf/Documents/GitHub_Projects/Python/OTHER/hermes-agent/node_modules/.bin:/home/dwarf/.xdg/data/mise/installs/node/25.9.0/bin:/home/dwarf/.local/bin:/home/dwarf/.cargo/bin:/home/dwarf/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="VIRTUAL_ENV=/home/dwarf/Documents/GitHub_Projects/Python/OTHER/hermes-agent/.venv"
Environment="HERMES_HOME=/home/dwarf/.hermes"
Restart=on-failure
RestartSec=30
RestartForceExitStatus=75
KillMode=mixed
KillSignal=SIGTERM
ExecReload=/bin/kill -USR1 $MAINPID
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
