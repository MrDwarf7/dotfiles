{
  "agent_servers": {
    "opencode": {
      "type": "extension",
      "favorite_models": ["opencode/grok-code"],
      "default_config_options": {},
      "favorite_config_option_values": {},
    },
  },
  "language_models": {
    "openai_compatible": {
      "oppencode": {
        "api_url": "https://opencode.ai/zen/v1/chat/completions",
        "available_models": [
          {
            "name": "grok-code",
            "max_tokens": 200000,
            "max_output_tokens": 32000,
            "max_completion_tokens": 200000,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": true,
              "prompt_cache_key": false,
              "chat_completions": true,
            },
          },
        ],
      },
    },
  },
  "title_bar": {
    "show_onboarding_banner": false,
  },
  "project_panel": {
    "button": false,
  },
  "search": {
    "center_on_match": true,
    "regex": true,
  },
  "hover_popover_delay": 300,
  "agent_buffer_font_size": 14.0,
  "context_servers": {
    "mcp-server-nextjs": {
      "enabled": true,
      "settings": {},
    },
    "shadcn-mcp-server": {
      "enabled": true,
      "settings": {},
    },
    "bun-docs": {
      "settings": {},

      "url": "https://bun.com/docs/mcp",
      "enabled": true,
      "headers": {},
    },

    "MCP_DOCKER": {
      "enabled": true,
      "command": "docker",
      "args": ["mcp", "gateway", "run"],
      "env": {},
    },
    "docker-mcp": {
      "enabled": true,
      "command": "docker",
      "args": ["mcp", "gateway", "run"],
      "env": {},
    },
    "container-use-mcp": {
      "enabled": true,
      "settings": {},
    },
    "mcp-server-context7": {
      "enabled": true,
      "settings": {
        "context8_api_key": "${CONTEXT7_API_KEY}",
      },
    },
    "Context7": {
      "enabled": false,
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
    },
    "postgres-context-server": {
      "enabled": true,
      "settings": {},
    },
    "mcp-server-linear": {
      "enabled": true,
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.linear.app/sse"],
      "env": {},
    },
  },
  "agent": {
    "favorite_models": [
      {
        "provider": "anthropic",
        "model": "claude-sonnet-4-5-latest",
      },
    ],
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "gpt-4o",
    },
    "always_allow_tool_actions": true,
    "default_profile": "write",
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-4-thinking",
    },
    "default_width": 700,
  },
  "lsp_highlight_debounce": 50,
  "auto_update_extensions": {
    "biome": true,
  },
  "file_finder": {
    "file_icons": true,
  },
  "auto_signature_help": false,
  "auto_update": true,
  "current_line_highlight": "all",
  "cursor_shape": "bar",
  "diagnostics": {
    "include_warnings": true,
    "inline": {
      "enabled": true,
      "update_debounce_ms": 150,
      "padding": 4,
      "min_column": 0,
      "max_severity": null,
    },
  },
  "enable_language_server": true,
  "file_scan_exclusions": ["**/target/**"],
  "git": {
    "git_gutter": "tracked_files",
    "gutter_debounce": null,
    "inline_blame": {
      "enabled": true,
      "delay_ms": 0,
    },
    "hunk_style": "unstaged_hollow",
  },
  "git_panel": {
    "default_width": 320,
  },
  "hide_mouse": "on_typing_and_movement",
  "icon_theme": "Material Icon Theme",
  "jsx_tag_auto_close": {
    "enabled": true,
  },
  "message_editor": {
    "auto_replace_emoji_shortcode": true,
  },
  "load_direnv": "shell_hook",
  "private_files": [
    "**/.env*",
    "**/config/*.toml",
    "**/config/*.json",
    "**/config/*.env*",
    "**/config/*.yml",
    "**/config/*.yaml",
    "**/config/*.lock",
  ],
  "preview_tabs": {
    "enable_keep_preview_on_code_navigation": true,
  },
  "scroll_beyond_last_line": "one_page",
  "seed_search_query_from_cursor": "selection",
  "selection_highlight": true,
  "show_signature_help_after_edits": true,
  "ssh_connections": [
    {
      "nickname": "nixbook",
      "host": "nixbook",
      "port": 22,
      "username": "dwarf",
      "upload_binary_over_ssh": true,
    },
  ],
  "slash_commands": {
    "cargo_workspace": {
      "enabled": true,
    },
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false,
  },
  "tabs": {
    "activate_on_close": "history",
    "file_icons": true,
    "git_status": true,
    "show_diagnostics": "all",
  },
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": false,
    "selections_menu": true,
  },
  "unnecessary_code_fade": null,
  "use_smartcase_search": true,
  "when_closing_with_no_tabs": "platform_default",
  "vim_mode": true,
  "preferred_line_length": 120,
  "show_wrap_guides": true,
  "wrap_guides": [100, 120],
  "soft_wrap": null,
  "ui_font_size": 15,
  // "ui_font_family": ".Zed Plex Mono",
  "ui_font_family": ".ZedMono",
  "ui_font_weight": 400,
  "ui_font_features": {
    "calt": false,
  },
  "buffer_line_height": "standard",
  "buffer_font_size": 14,
  // "buffer_font_family": "Zed Plex Mono",
  "buffer_font_family": ".ZedMono",
  "buffer_font_features": {
    "calt": false,
    "clig": false,
    "liga": false,
    "zero": true,
  },
  "cursor_blink": false,
  "relative_line_numbers": "enabled",
  "terminal": {
    "default_height": 400,
    "line_height": "standard",
    "font_family": "Mononoki Nerd Font Mono",
    "font_features": {
      "calt": false,
      "clig": false,
      "liga": false,
      "zero": true,
    },
    "shell": null,
  },
  "scrollbar": {
    "show": "never",
  },
  "vertical_scroll_margin": 2,
  "show_call_status_icon": true,
  "show_completion_documentation": true,
  "gutter": {
    "line_numbers": true,
    "folds": true,
    "runnables": true,
    "breakpoints": true,
    "min_line_number_digits": 4,
  },
  "theme": "Tokyo Night Storm",
  "indent_guides": {
    "enabled": true,
    "line_width": 1,
    "active_line_width": 1,
    "coloring": "indent_aware",
    "background_coloring": "disabled",
  },
  "show_edit_predictions": true,
  "features": {
    "edit_prediction_provider": "copilot",
    "experimental_edit_prediction_context_retrieval": true,
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "command": "clippy",
        },
        "completion": {
          "snippets": {
            "custom": {
              "Arc::new": {
                "postfix": "arc",
                "body": ["Arc::new(${receiver})"],
                "requires": "std::sync::Arc",
                "scope": "expr",
              },
              "Some": {
                "postfix": "some",
                "body": ["Some(${receiver})"],
                "scope": "expr",
              },
              "Ok": {
                "postfix": "ok",
                "body": ["Ok(${receiver})"],
                "scope": "expr",
              },
              "Rc::new": {
                "postfix": "rc",
                "body": ["Rc::new(${receiver})"],
                "requires": "std::rc::Rc",
                "scope": "expr",
              },
              "Box::pin": {
                "postfix": "boxpin",
                "body": ["Box::pin(${receiver})"],
                "requires": "std::boxed::Box",
                "scope": "expr",
              },
              "vec!": {
                "postfix": "vec",
                "body": ["vec![${receiver}]"],
                "description": "vec![]",
                "scope": "expr",
              },
            },
          },
        },
      },
    },
    "nixd": {
      "initialization_options": {
        "experimental": {
          "nix": {
            "enableNix": true,
            "enableNixFlake": true,
          },
        },
      },
    },
    "tailwindcss-language-server": {
      "settings": {
        "experimental": {
          "classRegex": [
            "\\.className\\s*[+]?=\\s*['\"]([^'\"]*)['\"]",
            "\\.setAttributeNS\\(.*,\\s*['\"]class['\"],\\s*['\"]([^'\"]*)['\"]",
            "\\.setAttribute\\(['\"]class['\"],\\s*['\"]([^'\"]*)['\"]",
            "\\.classList\\.add\\(['\"]([^'\"]*)['\"]",
            "\\.classList\\.remove\\(['\"]([^'\"]*)['\"]",
            "\\.classList\\.toggle\\(['\"]([^'\"]*)['\"]",
            "\\.classList\\.contains\\(['\"]([^'\"]*)['\"]",
            "\\.classList\\.replace\\(\\s*['\"]([^'\"]*)['\"]",
            "\\.classList\\.replace\\([^,)]+,\\s*['\"]([^'\"]*)['\"]",
          ],
        },
      },
    },
  },
  "languages": {
    "C": {
      "colorize_brackets": false,
      "format_on_save": "on",
    },
    "TOML": {
      "inlay_hints": {
        "enabled": true,
      },
    },
    "Nix": {
      "inlay_hints": {
        "enabled": true,
        "show_other_hints": true,
        "show_type_hints": true,
        "show_parameter_hints": true,
      },
      "formatter": {
        "external": {
          "command": "alejandra",
        },
      },
    },
    "TypeScript": {
      "colorize_brackets": true,
      "completions": {
        "lsp": false,
      },
      "enable_language_server": true,
      "prettier": {
        "allowed": false,
      },
      "formatter": "language_server",
    },
  },
  "inlay_hints": {
    "enabled": false,
    "show_type_hints": true,
    "show_parameter_hints": true,
    "show_other_hints": true,
    "edit_debounce_ms": 700,
    "scroll_debounce_ms": 50,
    // "maxLength": null
  },
  "vim": {
    "default_mode": "normal",
    "toggle_relative_line_numbers": false,
    "use_system_clipboard": "always",
    "use_smartcase_find": true,
    "highlight_on_yank_duration": 65,
    "cursor_shape": {
      "insert": "bar",
      "normal": "block",
      "replace": "underline",
      "visual": "block",
    },
    // "use_multiline_find": true,
  },
  "which_key": {
    "enabled": true, // default: false
    "delay_ms": 20, // default: 1000
  },
}
