// Only values that differ from Zed's defaults (`zed: open default settings`).
{
  "vim_mode": true,
  "vim": {
    "use_smartcase_find": true,
    "highlight_on_yank_duration": 65,
    "cursor_shape": {
      "insert": "bar"
    }
  },
  // Shows Zed's pending-binding popup for the space leader, like which-key.nvim.
  "which_key": {
    "enabled": true,
    "delay_ms": 20
  },
  "relative_line_numbers": "enabled",
  "vertical_scroll_margin": 2,
  "cursor_blink": false,
  "use_smartcase_search": true,
  "search": {
    // Gives vim's n/N the same recentring as nvim's nzzzv.
    "center_on_match": true,
    "regex": true
  },
  "seed_search_query_from_cursor": "selection",
  "scrollbar": {
    "show": "never"
  },
  "preferred_line_length": 120,
  "wrap_guides": [100, 120],

  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Tokyo Night Storm"
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme"
  },
  "ui_font_size": 15,
  "ui_font_family": ".ZedMono",
  "buffer_font_size": 14,
  "buffer_line_height": "standard",
  "buffer_font_features": {
    "calt": false,
    "clig": false,
    "liga": false,
    "zero": true
  },
  "terminal": {
    "default_height": 400,
    "font_family": "Mononoki Nerd Font Mono",
    "font_features": {
      "calt": false,
      "clig": false,
      "liga": false,
      "zero": true
    }
  },
  "auto_install_extensions": {
    "assembly": true,
    "biome": true,
    "catppuccin": true,
    "colored-zed-icons-theme": true,
    "colorizer": true,
    "csharp": true,
    "csv": true,
    "deno": true,
    "docker-compose": true,
    "dockerfile": true,
    "emmet": true,
    "fish": true,
    "git-firefly": true,
    "gleam": true,
    "graphene": true,
    "html": true,
    "ini": true,
    "just": true,
    "kdl": true,
    "log": true,
    "lua": true,
    "make": true,
    "markdown-oxide": true,
    "marksman": true,
    "material-icon-theme": true,
    "meson": true,
    "neocmake": true,
    "new-darcula": true,
    "nix": true,
    "nu": true,
    "powershell": true,
    "prisma": true,
    "proto": true,
    "ron": true,
    "sql": true,
    "the-dark-side": true,
    "tmux": true,
    "tokyo-night": true,
    "toml": true,
    "xy-zed": true,
    "zedokai": true,
    "zig": true
  },
  "auto_update_extensions": {
    "biome": true
  },

  "session": {
    "trust_all_worktrees": true
  },
  "title_bar": {
    "show_onboarding_banner": false,
    "show_branch_status_icon": true
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false
  },
  "tabs": {
    "file_icons": true,
    "git_status": true,
    "show_diagnostics": "all"
  },
  "toolbar": {
    "quick_actions": false
  },
  "project_panel": {
    "dock": "left",
    "button": false
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "left",
    "default_width": 320
  },
  "preview_tabs": {
    "enable_keep_preview_on_code_navigation": true
  },
  "hide_mouse": "on_typing_and_action",
  "use_autoclose": false,
  "use_auto_surround": false,
  "sticky_scroll": {
    "enabled": true
  },
  "unnecessary_code_fade": null,
  "show_signature_help_after_edits": true,
  "lsp_highlight_debounce": 50,
  "completions": {
    "words_min_length": 2
  },
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "git": {
    "gutter_debounce": null,
    "hunk_style": "unstaged_hollow"
  },
  "indent_guides": {
    "coloring": "indent_aware"
  },
  "file_scan_exclusions": ["**/target/**"],
  "private_files": [
    "**/.env*",
    "**/config/*.toml",
    "**/config/*.json",
    "**/config/*.env*",
    "**/config/*.yml",
    "**/config/*.yaml",
    "**/config/*.lock"
  ],
  "load_direnv": "shell_hook",
  "calls": {
    "mute_on_join": true
  },
  "ssh_connections": [
    {
      "nickname": "nixbook",
      "host": "nixbook",
      "port": 22,
      "username": "dwarf",
      "upload_binary_over_ssh": true
    }
  ],

  "edit_predictions": {
    "provider": "copilot"
  },
  "agent_ui_font_size": 16.0,
  "agent_buffer_font_size": 14.0,
  "agent": {
    "dock": "right",
    "default_width": 700,
    "profiles": {
      "write": {
        "name": "Write",
        "tools": {
          "search_web": true,
          "copy_path": true,
          "create_directory": true,
          "delete_path": true,
          "diagnostics": true,
          "edit_file": true,
          "fetch": true,
          "list_directory": true,
          "project_notifications": false,
          "move_path": true,
          "now": true,
          "find_path": true,
          "read_file": true,
          "restore_file_from_disk": true,
          "save_file": true,
          "open": true,
          "grep": true,
          "spawn_agent": true,
          "terminal": true,
          "thinking": true
        },
        "enable_all_context_servers": true,
        "context_servers": {}
      }
    },
    "tool_permissions": {
      "default": "allow"
    },
    "favorite_models": [
      {
        "provider": "openrouter",
        "model": "nvidia/nemotron-3-nano-30b-a3b",
        "enable_thinking": false
      },
      {
        "provider": "openrouter",
        "model": "openrouter/hunter-alpha",
        "enable_thinking": false
      }
    ],
    "inline_assistant_model": {
      "provider": "openrouter",
      "model": "nvidia/nemotron-3-nano-30b-a3b"
    },
    "default_model": {
      "enable_thinking": true,
      "provider": "openrouter",
      "model": "openrouter/hunter-alpha"
    }
  },
  "agent_servers": {
    "opencode": {
      "type": "registry",
      "favorite_models": ["opencode/grok-code", "openrouter/hunter-alpha"],
      "default_config_options": {},
      "favorite_config_option_values": {}
    }
  },
  "language_models": {
    "openai_compatible": {
      "nvidia": {
        "api_url": "https://openrouter.ai/api/v1",
        "available_models": [
          {
            "name": "nemotron-3-nano-30b-a3b:free",
            "max_tokens": 200000,
            "max_output_tokens": 32000,
            "max_completion_tokens": 200000,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": true,
              "prompt_cache_key": false,
              "chat_completions": true
            }
          },
          {
            "name": "nemotron-3-super-120b-a12b:free",
            "max_tokens": 200000,
            "max_output_tokens": 32000,
            "max_completion_tokens": 200000,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": true,
              "prompt_cache_key": false,
              "chat_completions": true
            }
          }
        ]
      },
      "oppencode": {
        "api_url": "https://opencode.ai/zen/v1/chat/completions",
        "available_models": [
          {
            "name": "grok-code",
            "max_tokens": 200000,
            "max_output_tokens": 32000,
            "max_completion_tokens": 200000,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": true,
              "prompt_cache_key": false,
              "chat_completions": true
            }
          }
        ]
      }
    }
  },
  "context_servers": {
    "prisma-mcp": {
      "enabled": false,
      "remote": false,
      "settings": {}
    },
    "mcp-server-nextjs": {
      "enabled": true,
      "settings": {}
    },
    "shadcn-mcp-server": {
      "enabled": true,
      "settings": {}
    },
    "bun-docs": {
      "url": "https://bun.com/docs/mcp",
      "enabled": false,
      "headers": {},
      "settings": {}
    },
    "MCP_DOCKER": {
      "enabled": true,
      "command": "docker",
      "args": ["mcp", "gateway", "run"],
      "env": {}
    },
    "container-use-mcp": {
      "enabled": true,
      "settings": {}
    },
    "mcp-server-context7": {
      "enabled": true,
      "settings": {
        "context7_api_key": "${CONTEXT7_API_KEY}"
      }
    },
    "Context7": {
      "enabled": false,
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "postgres-context-server": {
      "enabled": true,
      "settings": {}
    },
    "mcp-server-linear": {
      "enabled": false,
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.linear.app/sse"],
      "env": {}
    }
  },

  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "command": "clippy"
        },
        "completion": {
          "snippets": {
            "custom": {
              "Arc::new": {
                "postfix": "arc",
                "body": ["Arc::new(${receiver})"],
                "requires": "std::sync::Arc",
                "scope": "expr"
              },
              "Some": {
                "postfix": "some",
                "body": ["Some(${receiver})"],
                "scope": "expr"
              },
              "Ok": {
                "postfix": "ok",
                "body": ["Ok(${receiver})"],
                "scope": "expr"
              },
              "Rc::new": {
                "postfix": "rc",
                "body": ["Rc::new(${receiver})"],
                "requires": "std::rc::Rc",
                "scope": "expr"
              },
              "Box::pin": {
                "postfix": "boxpin",
                "body": ["Box::pin(${receiver})"],
                "requires": "std::boxed::Box",
                "scope": "expr"
              },
              "vec!": {
                "postfix": "vec",
                "body": ["vec![${receiver}]"],
                "description": "vec![]",
                "scope": "expr"
              }
            }
          }
        }
      }
    },
    "nixd": {
      "initialization_options": {
        "experimental": {
          "nix": {
            "enableNix": true,
            "enableNixFlake": true
          }
        }
      }
    },
    "tailwindcss-language-server": {
      "settings": {
        "experimental": {
          "classRegex": [
            "\\.className\\s*[+]?=\\s*['\"]([^'\"]*)['\"]",
            "\\.setAttributeNS\\(.*,\\s*['\"]class['\"],\\s*['\"]([^'\"]*)['\"]",
            "\\.setAttribute\\(['\"]class['\"],\\s*['\"]([^'\"]*)['\"]",
            "\\.classList\\.add\\(['\"]([^'\"]*)['\"]",
            "\\.classList\\.remove\\(['\"]([^'\"]*)['\"]",
            "\\.classList\\.toggle\\(['\"]([^'\"]*)['\"]",
            "\\.classList\\.contains\\(['\"]([^'\"]*)['\"]",
            "\\.classList\\.replace\\(\\s*['\"]([^'\"]*)['\"]",
            "\\.classList\\.replace\\([^,)]+,\\s*['\"]([^'\"]*)['\"]"
          ]
        }
      }
    }
  },
  "languages": {
    "C": {
      "colorize_brackets": false,
      "format_on_save": "on",
      "formatter": "auto",
      "completions": {
        "lsp": true,
        "lsp_fetch_timeout_ms": 0,
        "words_min_length": 2
      }
    },
    "Python": {
      "format_on_save": "on",
      "colorize_brackets": true,
      "formatter": "language_server",
      "completions": {
        "lsp": true,
        "words_min_length": 1
      }
    },
    "TOML": {
      "inlay_hints": {
        "enabled": true
      }
    },
    "Nix": {
      "inlay_hints": {
        "enabled": true,
        "show_other_hints": true,
        "show_type_hints": true,
        "show_parameter_hints": true
      },
      "formatter": {
        "external": {
          "command": "alejandra"
        }
      }
    },
    "TypeScript": {
      "colorize_brackets": true,
      "completions": {
        "lsp": false
      },
      "enable_language_server": true,
      "prettier": {
        "allowed": false
      },
      "formatter": "language_server"
    }
  }
}
