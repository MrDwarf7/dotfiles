// Deltas on top of Zed's built-in vim keymap (assets/keymaps/vim.json), not a copy of it.
// Precedence: the binding whose context matches at the deepest node (Editor > Pane > Workspace)
// wins; at the same node the later definition wins, and this file loads last. Vim-mode contexts
// all match on the Editor node, so any vim_mode/VimControl block here shadows vim.json's.
// Inspect live contexts with `dev: open key context view`; conflicts show in `zed: open keymap`.
[
  {
    "context": "VimControl && !menu",
    "bindings": {
      "shift-h": "vim::FirstNonWhitespace",
      "shift-l": "vim::EndOfLine",

      "g t": "editor::GoToTypeDefinition",
      "g i": "editor::GoToImplementation",
      "g r": "editor::FindAllReferences",

      // Pane binds ctrl-1..9 to tab N; the editor node is deeper so this wins only in editors.
      "ctrl-6": "pane::AlternateFile",
      "z backspace": "editor::ScrollCursorBottom",

      "] e": ["editor::GoToDiagnostic", { "severity": "error" }],
      "[ e": ["editor::GoToPreviousDiagnostic", { "severity": "error" }],
      "] w": ["editor::GoToDiagnostic", { "severity": "warning" }],
      "[ w": ["editor::GoToPreviousDiagnostic", { "severity": "warning" }],
      "] h": "editor::GoToHunk",
      "[ h": "editor::GoToPreviousHunk",
      "] t": "pane::ActivateNextItem",
      "[ t": "pane::ActivatePreviousItem"
    }
  },
  {
    // Bound after y is pushed, not as "y g f" in normal mode: a multi-key "y …" binding turns
    // every y into a pending prefix, so yy stalls for the keystroke timeout on each y.
    "context": "vim_operator == y",
    "bindings": {
      "g f": ["workspace::SendKeystrokes", "escape g g shift-v shift-g y"],
      "g shift-f": ["workspace::SendKeystrokes", "escape g g shift-v shift-g y shift-g"]
    }
  },
  {
    "context": "vim_mode == normal && !menu",
    "bindings": {
      // Neovim's Y is y$; the extra two-key forms make Y wait like nvim's timeoutlen does.
      "shift-y": ["workspace::SendKeystrokes", "y $"],
      "shift-y shift-y": ["workspace::SendKeystrokes", "v a { shift-v y"],
      "shift-y y": ["workspace::SendKeystrokes", "v i { shift-v y"],

      "ctrl-k": "editor::ShowSignatureHelp",

      "left": "vim::ResizePaneRight",
      "right": "vim::ResizePaneLeft",
      "up": "vim::ResizePaneUp",
      "down": "vim::ResizePaneDown",
      "ctrl-h": "vim::ResizePaneRight",
      "ctrl-l": "vim::ResizePaneLeft",

      "ctrl-w e": "vim::ResetPaneSizes",
      "ctrl-w t": "pane::ReopenClosedItem",
      // Closing every item closes the pane, which is what nvim's ctrl-w c does to a window.
      "ctrl-w c": "pane::CloseAllItems",
      "ctrl-w ctrl-c": "pane::CloseAllItems",
      "ctrl-shift-i": "agent::ToggleFocus",

      "space e": "project_panel::ToggleFocus",
      "space n": "pane::ActivateNextItem",
      "space p": "pane::ActivatePreviousItem",
      "space b n": "pane::ActivateNextItem",
      "space b p": "pane::ActivatePreviousItem",
      "space b d": "pane::CloseActiveItem",
      "space b shift-d": "pane::CloseOtherItems",
      "space b e": "workspace::NewFile",
      "space b c": "workspace::NewFile",

      // Harpoon stand-in: pinned tabs sort first, so slot N is the Nth pinned file.
      "space i": "pane::TogglePinTab",
      "space shift-i": "tab_switcher::Toggle",
      "space 1": ["pane::ActivateItem", 0],
      "space 2": ["pane::ActivateItem", 1],
      "space 3": ["pane::ActivateItem", 2],
      "space 4": ["pane::ActivateItem", 3],
      "space 5": ["pane::ActivateItem", 4],
      "space 6": ["pane::ActivateItem", 5],

      "space f f": "file_finder::Toggle",
      "space f b": "tab_switcher::ToggleAll",
      "space f w": "pane::DeploySearch",
      // DeploySearch only seeds from a selection (seed_search_query_from_cursor), so select the word first.
      "space f shift-w": ["workspace::SendKeystrokes", "v i w g /"],
      "space f shift-r": ["pane::DeploySearch", { "replace_enabled": true }],
      "space f s": "buffer_search::Deploy",
      "space /": "buffer_search::Deploy",
      "space f d": "diagnostics::Deploy",
      "space f shift-d": "diagnostics::DeployCurrentFile",
      "space f p": "projects::OpenRecent",
      "space f k": "zed::OpenKeymap",
      "space f shift-c": "command_palette::Toggle",
      "space f shift-u": "theme_selector::Toggle",
      "space f g s": "git_panel::ToggleFocus",
      "space f g b": "git::Switch",

      "space l a": "editor::ToggleCodeActions",
      "space l h": "editor::Hover",
      "space l s": "outline::Toggle",
      "space l f": "editor::Format",
      "space l r": "editor::Rename",
      "space l d": "diagnostics::Deploy",
      "space l shift-d": "diagnostics::DeployCurrentFile",
      "space l p": ["pane::DeploySearch", { "replace_enabled": true }],
      "space l shift-r": ["pane::DeploySearch", { "replace_enabled": true }],

      "space h p": "editor::ToggleSelectedDiffHunks",
      "space h shift-p": "editor::ExpandAllDiffHunks",
      "space h shift-c": "editor::CollapseAllDiffHunks",
      "space h r": "git::Restore",
      "space h shift-r": "git::RestoreFile",
      "space h s": "git::ToggleStaged",
      "space h shift-s": "git::StageFile",
      "space h b": "editor::BlameHover",
      "space h shift-b": "git::Blame",
      "space h t": "editor::ToggleGitBlameInline",
      "space h d": "git::Diff",

      "space g shift-i": "git::Init",
      "space g g": "git_panel::ToggleFocus",
      "space g w": "git_panel::ToggleFocus",
      "space g a": "git::Add",
      "space g p": "git::Pull",
      "space g shift-p": "git::Push",
      "space g d": "git::Diff",
      "space g f": "git::Fetch",
      "space g e": "git::ExpandCommitEditor",
      "space g c": "git::Commit",
      "space g b": "git::Switch",
      "space g s": "git::StageAndNext",
      "space g shift-a": "git::StageAll",
      "space g u": "git::UnstageAndNext",
      "space g shift-u": "git::UnstageAll",

      "space t a": "agent::ToggleFocus",
      "space t b": "workspace::ToggleLeftDock",
      "space t v": "workspace::CloseAllDocks",
      "space t i": "editor::ToggleInlayHints",
      "space t t": "workspace::NewTerminal",
      "space t ;": "terminal_panel::ToggleFocus",
      "space t w": "editor::ToggleSoftWrap",
      "space t z": "workspace::ToggleCenteredLayout",
      "space t shift-z": "workspace::ToggleZoom",

      "space w h": "workspace::MovePaneLeft",
      "space w j": "workspace::MovePaneDown",
      "space w k": "workspace::MovePaneUp",
      "space w l": "workspace::MovePaneRight",

      "space y f": "workspace::CopyPath",
      "space y n": "editor::CopyFileName",
      "space y shift-n": "editor::CopyFileNameWithoutExtension",

      "space d b": "editor::ToggleBreakpoint",
      "space d shift-b": "debugger::ClearAllBreakpoints",
      // f5 is Continue while stopped and Rerun otherwise, which mirrors dap.continue() starting a session.
      "space d c": ["workspace::SendKeystrokes", "f5"],
      "space d i": "debugger::StepInto",
      "space d o": "debugger::StepOver",
      "space d shift-o": "debugger::StepOut",
      "space d u": "debug_panel::ToggleFocus",

      "space o r": "editor::SpawnNearestTask",
      "space o l": "task::Rerun"
    }
  },
  {
    "context": "vim_mode == visual && !menu",
    "bindings": {
      "p": ["vim::Paste", { "preserve_clipboard": true }],
      // Indent drops to normal mode but stores the visual marks, so gv reselects.
      ">": ["workspace::SendKeystrokes", "> g v"],
      "<": ["workspace::SendKeystrokes", "< g v"],
      "ctrl-shift-i": "assistant::InlineAssist",

      "space l a": "editor::ToggleCodeActions",
      "space l f": "editor::FormatSelections",
      "space f shift-w": "pane::DeploySearch",
      "space f shift-r": ["pane::DeploySearch", { "replace_enabled": true }]
    }
  },
  {
    "context": "vim_mode == insert",
    "bindings": {
      "j k": "vim::NormalBefore",
      "k j": "vim::NormalBefore",
      "ctrl-shift-i": "assistant::InlineAssist",
      // nvim's blink binds these to select_next/prev with no fallback, so outside a menu they do
      // nothing; here they'd fall through to macOS JoinLines and vim's digraph prefix.
      "ctrl-j": null,
      "ctrl-k": null
    }
  },
  {
    // Must come after the insert block's ctrl-j/ctrl-k nulls (same Editor node, later wins).
    "context": "Editor && (showing_code_actions || showing_completions)",
    "bindings": {
      "ctrl-j": "editor::ContextMenuNext",
      "ctrl-k": "editor::ContextMenuPrevious"
    }
  },
  {
    "context": "Picker > Editor",
    "bindings": {
      "ctrl-j": "menu::SelectNext",
      "ctrl-k": "menu::SelectPrevious"
    }
  },
  {
    // Without these, `space f` (built-in, fires instantly) opens the finder and the next `f` lands in its query.
    "context": "EmptyPane || (ProjectPanel && not_editing)",
    "bindings": {
      "space e": "project_panel::ToggleFocus",
      "space f f": "file_finder::Toggle",
      "space f w": "pane::DeploySearch"
    }
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "a": "project_panel::NewFile",
      "shift-a": "project_panel::NewDirectory",
      "d": "project_panel::Delete",
      "r": "project_panel::Rename",
      "o": "project_panel::OpenPermanent",
      "v": "project_panel::OpenPermanent",
      "p": "project_panel::Paste",
      "x": "project_panel::Cut",
      "y y": "project_panel::Copy",
      "y i": "project_panel::Duplicate",
      "y c": "workspace::CopyPath",
      "y shift-c": "workspace::CopyRelativePath",
      "ctrl-h": "project_panel::CollapseAllEntries",
      "ctrl-v": "project_panel::OpenSplitVertical",
      "ctrl-s": "project_panel::OpenSplitHorizontal",
      "g x": "workspace::OpenWithSystem",
      "g .": "project_panel::ToggleHideHidden"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-tab": "pane::ActivateNextItem",
      "ctrl-shift-tab": "pane::ActivatePreviousItem",
      "ctrl-:": "terminal_panel::ToggleFocus"
    }
  },
  {
    "context": "Pane",
    "bindings": {
      "ctrl-shift-t": "pane::ReopenClosedItem"
    }
  },
  {
    // ctrl-w only works where vim is active or nothing editable is focused; tabs like Extensions
    // focus a plain search input that swallows it. The second clause is vim.json's own
    // "not in an editor or terminal" scope, so alt-d still reaches the shell in the terminal.
    "context": "Editor || (!Editor && !Terminal)",
    "bindings": {
      "alt-d": "pane::CloseActiveItem"
    }
  },
  {
    // One null at the Editor node shadows every Editor-level default for these keys:
    // alt-tab would show/accept edit predictions, alt-up/down would move lines.
    "context": "Editor",
    "bindings": {
      "alt-tab": null,
      "alt-up": null,
      "alt-down": null
    }
  },
  {
    "context": "Editor && edit_prediction",
    "bindings": {
      "tab": "editor::AcceptEditPrediction",
      "ctrl-right": "editor::AcceptNextWordEditPrediction",
      "ctrl-down": "editor::AcceptNextLineEditPrediction"
    }
  },
  {
    "context": "!SettingsWindow",
    "bindings": {
      "ctrl-,": "zed::OpenSettings"
    }
  },
  {
    "context": "!SettingsWindow",
    "unbind": {
      "cmd-,": "zed::OpenSettings"
    }
  }
]
