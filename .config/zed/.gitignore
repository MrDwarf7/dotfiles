*
!/.gitignore
!/keymap.json
!/settings.json
!/AGENTS.md
!/themes/
!/themes/*.json
!/prompts/
!/prompts/**/
!/prompts/**/*.md
!/prompts/**/*.txt

# Preserve the binary prompt library locally; review exports before tracking.
# data.mdb and lock.mdb remain ignored by the default rule.

# Never include credential or backup files through the directory exceptions.
**/keys.*
**/.env*
**/*credentials*
**/*secrets*
**/*.bak*
**/*_backup*
