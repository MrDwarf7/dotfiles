# NVIDIA Specific 
export GBM_BACKEND=nvidia-drm                # it causes issues like Hyprland crashing so care
export __GLX_VENDOR_LIBRARY_NAME=nvidia
export LIBVA_DRIVER_NAME=nvidia
export __GL_GSYNC_ALLOWED=1                  # - Controls if G-Sync capable monitors should use Variable Refresh Rate (VRR)
export __GL_VRR_ALLOWED=0                    # - Controls if Adaptive Sync should be used. Recommended to set as 0 to avoid having problems with some games


# Themeing Related Variables
