
environment {
  GDK_BACKEND "wayland,x11"

  // Toolkit Backend Variables
  QT_QPA_PLATFORM "wayland"

  SDL_VIDEODRIVER "wayland"
  CLUTTER_BACKEND "wayland"

  // XDG Specifications
  XDG_CURRENT_DESKTOP "niri"
  XDG_SESSION_TYPE "wayland"
  XDG_SESSION_DESKTOP "niri"

  // Qt Variables
  QT_AUTO_SCREEN_SCALE_FACTOR "1"

  QT_WAYLAND_DISABLE_WINDOWDECORATION "1"

  // it causes issues like Hyprland crashing so care
  GBM_BACKEND "nvidia-drm"

  __GLX_VENDOR_LIBRARY_NAME "nvidia"
  LIBVA_DRIVER_NAME "nvidia"

  //  Controls if G-Sync capable monitors should use Variable Refresh Rate (VRR)                                 
  // __GL_GSYNC_ALLOWED "1"

  // Controls if Adaptive Sync should be used. Recommended to set as 0 to avoid having problems with some games

  // __GL_VRR_ALLOWED "0"

  GTK_THEME "Tokyonight-Dark-B"

  HYPRCURSOR_THEME "Hyprcursor-Bibata-Modern-Classic"
  HYPRCURSOR_SIZE "24"

  XCURSOR_THEME "Bibata-Modern-Classic"
  XCURSOR_SIZE "24"

  WLR_RENDERER_ALLOW_SOFTWARE "1"
  WLR_NO_HARDWARE_CURSORS "1"// Uncommented; enable if needed for NVIDIA
  NVD_BACKEND "direct"
  ELECTRON_OZONE_PLATFORM_HINT "wayland"

  WEBKIT_DISABLE_DMABUF_RENDERER "1"
  MOZ_ENABLE_WAYLAND "1"
  WALLPAPER_BACKEND "swww"

}
