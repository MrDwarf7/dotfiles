# This is the configuration file for Ghostty.

# Config generated by Ghostty Config

# Most of these are off atm (exp. for `custom-shader-animation`)
config-file = ?shaders.conf
config-file = themes/tokyonight_storm.conf
# config-file = themes/matteblack.conf

################
### Settings ###
################

confirm-close-surface = false
shell-integration = fish
clipboard-read = allow
copy-on-select = false
window-theme = dark
window-padding-x = 4
window-padding-y = 2
window-padding-balance = true

# background-blur = 35

#### uncomment after fixing up Niri
# background-blur = 90

# Standard
# background-opacity = 0.90

# Translucent-lite
# background-opacity = 0.85

# Translucent
# Anything lower than about 0.5 causes text sharpness issues
# background-opacity = 0.40

#### uncomment after fixing up Niri
background-opacity = 0.4

# background-opacity = 0.95

window-decoration = none

bold-is-bright = false
cursor-style = bar
cursor-style-blink = true

# font-family = JetBrainsMono Nerd Font Mono
#### previous #### font-family = Mononoki Nerd Font Mono
# font-family = Zenbones Brainy Medium Regular

# font-family = Zenbones Brainy Light
# font-family = Zenbones Mono Thin
# font-family = Zenbones Brainy Medium

# font-family = Zenbones Proto
# font-family = Zenbones Mono
font-family = Zenbones Brainy
# Medium

# font-size = 10.5
font-size = 10.2
font-thicken = false

# ss01 - use normal asterisk, potentially higher in the cell (as opposed to centered etc.)
# ss04 - use normal g ( with the gap on the left, like a lowercase Y )
# ss08 - use squashed parentheses ()
# ss11 - use squished `x` when identified for hexadecimal digits
# ss12 - thin backslash
# ss13 - dollar symbol without strike-through vertical line
# font-feature = ["ss04" "ss08" ]
font-feature = -calt, -liga, -dlig, -ss12, -ss13

## Zenbones Brainy with `+ss11` causes the `~` symbol to be too high up,
## one of the options screws up the ~ symbol (too high up)
# -clig, -ss01, -ss08, +ss11, -ss12, -ss13

adjust-cursor-thickness = 1
adjust-box-thickness = 1

mouse-hide-while-typing = true
gtk-single-instance = true
gtk-tabs-location = bottom
gtk-wide-tabs = false

config-file = keys.conf
