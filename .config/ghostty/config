# This is the configuration file for Ghostty.

# Config generated by Ghostty Config

# Most of these are off atm (exp. for `custom-shader-animation`)
config-file = ?shaders.conf

################
### Settings ###
################

confirm-close-surface = false
shell-integration = fish
clipboard-read = allow
copy-on-select = false
window-theme = dark
window-padding-x = 4
window-padding-y = 6
window-padding-balance = true

# background-blur = 35

background-blur = 20

# Standard
# background-opacity = 0.90

# Translucent-lite
# background-opacity = 0.85

# Translucent
# Anything lower than about 0.5 causes text sharpness issues
background-opacity = 0.65
# background-opacity = 0.40


theme = TokyoNight Storm


bold-is-bright = false
cursor-style = bar
cursor-style-blink = true
font-size = 11.5
font-thicken = false
font-feature = ["ss04" "ss01"]
# font-family = JetBrainsMono Nerd Font Mono
font-family = Mononoki Nerd Font Mono
adjust-cursor-thickness = 1
adjust-box-thickness = 1

mouse-hide-while-typing = true
gtk-single-instance = true
gtk-tabs-location = bottom
gtk-wide-tabs = false

config-file = keys.conf
