{
    "layer": "top",
    "position": "top",
    "reload_style_on_change": true,
    "modules-left": [
        "custom/notification",
        "clock",
        "custom/endpoint",
        "custom/pacman",
        "custom/terminal",
        "custom/endpoint",
        "tray",
        "custom/endpoint",
        "mpris"
    ],
    "modules-center": [
        "hyprland/workspaces"
    ],
    "modules-right": [
        "wlr/taskbar",
        "custom/endpoint",
        "pulseaudio",
        "custom/endpoint",
        "group/expand",
        "bluetooth",
        "network",
        "battery",
        "idle_inhibitor"
    ],

    // LEFT 
    // Left most -> right
    "custom/notification": {
        "tooltip": false,
        "format": "",
        "on-click": "sleep 0.1 && swaync-client -t -sw",
        "on-click-right": "sleep 0.1 && swaync-client -d -sw",
        "escape": true
    },
    "clock": {
        "format": "{:%I:%M:%S %p}",
        "interval": 1,
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "format": {
                "today": "<span color='#fAfBfC'><b>{}</b></span>"
            }
        },
        "actions": {
            "on-click-right": "shift_down",
            "on-click": "shift_up"
        }
    },
    "custom/pacman": {
        "format": " {}",
        "interval": 30,
        "exec": "checkupdates | wc -l",
        "exec-if": "exit 0",
        "on-click": "wezterm -e fish -c 'sysup; echo Done - Press enter to exit; read'; pkill -SIGRTMIN+8 waybar",
        "signal": 8,
        "tooltip": false
    },
    "custom/terminal": {
        "tooltip": "Start your terminal",
        "format": "",
        "on-click": "wezterm"
    },
    "tray": {
        "icon-size": 14,
        "spacing": 10
    },
    "mpris": {
        "format": "{dynamic} {player_icon}",
        "interval": 1.0,
        "format-paused": "<i>{dynamic}</i> {status_icon}",
        "player-icons": {
            "default": "",
            "mpv": ""
        },
        "status-icons": {
            "paused": ""
        },
        "ignored-players": ["firefox", "zen-browser"],
        "dynamic-order": [
            "title",
            "artist",
            // "album",
            "position",
            "length"
        ]
    },
    // LEFT END

    // MIDDLE
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "",
            "default": "",
            "empty": ""
        },
        // "move-to-monitor": true,
        "persistent-workspaces": {
            "*": [1, 2, 3, 4, 5]
        }
    },
    // MIDDLE END

    // RIGHT
    // Center most -> left
    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 14,
        // "icon-theme": "Numix-Circle",
        // "sort-by-app-id": true,
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close",
        "ignore-list": [
            "sh",
            "Alacritty",
            "wezterm",
            "Wezterm",
            "wezterm-gui",
            "Wezterm-gui"
        ],
        "app_ids-mapping": {
            "firefoxdeveloperedition": "firefox-developer-edition"
        },
        "rewrite": {
            // "Zen Browser": "Zen",
            "Firefox Web Browser": "Firefox",
            "Foot Server": "Terminal"
        }
    },

    // endpoint

    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-bluetooth": "{volume}% {icon}",
        "format-muted": "{volume}% ",
        "format-icons": {
            "alsa_output.pci-0000_00_1f.3.analog-stereo": "",
            "alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "",
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "phone-muted": "",
            "portable": "",
            "car": "",
            "default": ["", ""]
        },
        "scroll-step": 1,
        "on-click": "pavucontrol",
        "on-click-middle": "sleep 0.1 && pactl set-source-mute @DEFAULT_SOURCE@ toggle",
        "on-click-right": "sleep 0.1 && pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "ignored-sinks": ["Easy Effects Sink"]
    },

    // endpoint

    "group/expand": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 500,
            "transition-to-left": true,
            "click-to-reveal": true
        },
        "modules": [
            "custom/expand",
            "custom/colorpicker",
            "cpu",
            "memory",
            "temperature",
            "custom/endpoint"
        ]
    },
    "cpu": {
        // "format": "󰻠",
        "format": "",
        "tooltip": true
    },
    "memory": {
        // "format": ""
        "format": ""
    },
    "temperature": {
        "critical-threshold": 80,
        "format": ""
    },

    // endpoint

    "bluetooth": {
        // "format-on": "󰂯",
        "format-on": "",
        "format-off": "BT-off",
        "format-disabled": "󰂲",
        "format-connected-battery": "{device_battery_percentage}% 󰂯",
        "format-alt": "{device_alias} 󰂯",
        "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\n{device_address}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}\n{device_address}\n{device_battery_percentage}%",
        "on-click-right": "blueman-manager"
    },
    "network": {
        "format-wifi": "",
        // "format-ethernet": "",
        "format-ethernet": "",
        "format-disconnected": "",
        "tooltip-format-disconnected": "Error",
        "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
        "tooltip-format-ethernet": "{ifname} 🖧 ",
        "on-click": "wezterm nmtui"
    },
    "battery": {
        "interval": 30,
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 20
        },
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% 󰂄",
        "format-plugged": "{capacity}% 󰂄 ",
        "format-alt": "{time} {icon}",
        "format-icons": [
            "󰁻",
            "󰁼",
            "󰁾",
            "󰂀",
            "󰂂",
            "󰁹"
        ]
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    // RIGHT END

    // misc

    "custom/endpoint": {
        // "format": "|",
        "format": "|",
        "tooltip": false
    },

    "custom/expand": {
        // "format": "",
        "format": "",
        "tooltip": false
    }
}
