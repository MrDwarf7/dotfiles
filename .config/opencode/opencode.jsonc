{
  "$schema": "https://opencode.ai/config.json",
  // Start with default binds
  //Instructions files to load on startup
  "instructions": [
    "~/.config/opencode/AGENTS.md", // Not sure if this works, but we'll see
    "AGENTS.md",
    "TODO.md",
    "CONTRIBUTING.md",
    "docs/TOOLS.md",
    "docs/MODELS.md",
    "docs/*",
    ".opencode/*",
  ],
  "formatter": {
    "prettier": {
      "disabled": true,
    },
  },
  // MCP servers and configuration
  "mcp": {
    "context7": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7-API-KEY": "${CONTEXT7_API_KEY}"
      },
    },
    // // All of these are directly from Zed's config file
    // "mcp-server-nextjs": {
    //   "enabled": true,
    //   "type": "local",
    //   "command": "npx",
    //   "args": [
    //     "-y",
    //     "mcp-nextjs-server",
    //     "dev"
    //   ],
    //   "settings": {},
    // },
    // "shadcn-mcp-server": {
    //   "enabled": true,
    //   "settings": {},
    // },
    // "bun-docs": {
    //   "settings": {},
    //   "url": "https://bun.com/docs/mcp",
    //   "enabled": true,
    //   "headers": {},
    // },
    // "MCP_DOCKER": {
    //   "enabled": true,
    //   "command": "docker",
    //   "args": [
    //     "mcp",
    //     "gateway",
    //     "run"
    //   ],
    //   "env": {},
    // },
    // "docker-mcp": {
    //   "enabled": true,
    //   "command": "docker",
    //   "args": [
    //     "mcp",
    //     "gateway",
    //     "run"
    //   ],
    //   "env": {},
    // },
    // "container-use-mcp": {
    //   "enabled": true,
    //   "settings": {},
    // },
    // "postgres-context-server": {
    //   "enabled": true,
    //   "settings": {},
    // },
    // "mcp-server-linear": {
    //   "enabled": true,
    //   "command": "npx",
    //   "args": [
    //     "-y",
    //     "mcp-remote",
    //     "https://mcp.linear.app/sse"
    //   ],
    //   "env": {},
    // },
  },
  // This is a list of the allowed tools/permissions
  // All are enabled by default
  "permission": {
    "bash": "allow",
    "edit": "allow", // covers both edit and writing
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "list": "allow",
    "lsp": "allow",
    "skill": "allow", // not in the lsp hover, but is in docs
    "todowrite": "allow",
    "todoread": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "question": "allow",
    // "doom_loop": "allow", // This is *detection* of it (3 tool calls with identical input)
  },
  // Experimental features
  "experimental": {
    "chatMaxRetries": 3,
    "batch_tool": true,
    "disable_paste_summary": true,
    "mcp_timeout": 60000,
    "openTelemetry": false,
    "continue_loop_on_deny": true,
  },
}
