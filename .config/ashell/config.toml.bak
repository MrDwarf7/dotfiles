log_level = "warn"
# log_level = "debug"
outputs  = "All"
position = "Top"
# enable_escape_key = true ## while menu open, retains exclusive control of it

## Very simple
# [modules]
# left   = [ "Clock" ]
# center = [ "Workspaces" ]
# right  = [ "Settings" ]

[modules]
left   = [ [ "CNotificaiton", "Tempo" ], "Tray", "MediaPlayer" ]
center = [ [ "Workspaces" ] ]
right  = [ "WindowTitle", [ "Updates" ], [ "SystemInfo", "Privacy", "Settings" ] ]


## Soft-Depr. use Tempo instead
# [clock]
# format = "| %b, %F | %r " # | %sort-month, year-month-day | 12-hour:min:sec AM/PM

[tempo]
## Formatting done using chrono's strftime syntax
## https://docs.rs/chrono/latest/chrono/format/strftime/index.html
clock_format = "| %b, %F | %r " # | %sort-month, year-month-day | 12-hour:min:sec AM/PM
# weather_time_format = "%R"
weather_location = "Current"


# format = "%I:%M:%S %p %D"
# format = "|%b| %d-%m-%Y"

####
# format = "%I:%M:%S %p" # 12-hour, min, sec, AM/PM
# format = "%I:%M:%S [%f ns] %p" # same, but with nanoseconds
#
# format = "|%b| %F" # |short name month| year-month-day
###
# format = "| %b, %F | %I:%M:%S %p"
####

[updates]
check_cmd  = "checkupdates; paru -Qua"
update_cmd = "ghostty -e fish -c 'sysup -s m; echo Done - Press enter to exit; read' &"

[media_player]
max_title_length = 40

[workspaces]
# visibility_mode = "All"
visibility_mode          = "MonitorSpecificExclusive"
enable_workspace_filling = true
max_workspaces           = 5

[window_title]
truncate_title_after_length = 50
mode                        = "Title"

[system_info]
# indicators = [ "Cpu", "Memory", "Temperature", { Disk = "/home" } ]
indicators = [ "Cpu", "Memory", "Temperature", { Disk = "/home" } ]

[system_info.cpu]
warn_threshold  = 60
alert_threshold = 80

[system_info.memory]
warn_threshold  = 70
alert_threshold = 85

[system_info.disk]
warn_threshold  = 80
alert_threshold = 90

[system_info.temperature]
warn_threshold  = 60
alert_threshold = 80

[settings]
lock_cmd               = "hyprlock &"
shutdown_cmd           = "shutdown now"
suspend_cmd            = "systemctl suspend"
reboot_cmd             = "systemctl reboot"
logout_cmd             = "loginctl kill-user $(whoami)"
audio_sinks_more_cmd   = "pavucontrol -t 3"
audio_sources_more_cmd = "pavucontrol -t 4"
remove_idle_btn        = false


[[CustomModule]]
name       = "CNotificaiton"
icon       = ""
command    = "sleep 0.1; swaync-client -t -sw"
listen_cmd = "swaync-client -swb"
icons.dnd  = ""
alert      = ".*notification"


###### Appearance


[appearance]
# font_name = "Fira Sans"
font_name = "Mononoki Nerd Font"
# scale_factor = 1.065
scale_factor = 1.100
# scale_factor = 1.000
## bugged when using "Island" style
# style        = ""  # "Island" | "Solid" | "Gradient"
# style = "Solid" # | "Gradient"

opacity = 0.8
# backdrop = 0.3

[appearance.menu]
opacity = 0.65
# backdrop = 0.3

[appearance.background_color]
base = "#291F1A"
