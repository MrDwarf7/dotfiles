-- ---@param opts config.LSP.handle_builtins.Opts
local handle_builtins = function(opts)
  opts = opts or {}

  local lists = require("utils.list")
  local maybe_qf = lists.find_qf("q") -- could be empty table
  local maybe_loc = lists.find_qf("l") -- could be empty table

  -- perform the operation
  local ok, ret = pcall(opts.operation)
  if not ok then
    require("utils.output").warn(ret)
    return
  end

  -- check if we need to jump
  local qf_after = lists.find_qf("q")
  local loc_after = lists.find_qf("l")

  if #qf_after == 1 and #maybe_qf == 0 then
    vim.cmd("cfirst")
  elseif #loc_after == 1 and #maybe_loc == 0 then
    vim.cmd("lfirst")
  end
end

------------------------------------------------------

function LSP.builtin()
  -- local map = vim.keymap.set
  local map = require("config.keymaps")
	-- local trouble = require("trouble")


	-- stylua: ignore start
	map("n", "gd", function() handle_builtins({ operation = vim.lsp.buf.definition, }) end,
		{ desc = "[G]oto [d]efinition" })

	map("n", "gD", function() handle_builtins({ operation = vim.lsp.buf.declaration, }) end,
		{ desc = "Goto T[y]pe Definition" })


	map("n", "gr", function() handle_builtins({ operation = vim.lsp.buf.references, }) end,
		{ desc = "[G]oto [r]eferences" })

	-- map("n", "gr", function() vim.lsp.buf.references(nil, { loclist = true }) end, { desc = "[G]oto [r]eferences" })
	map("n", "gt", function() handle_builtins({ operation = vim.lsp.buf.type_definition, }) end,
		{ desc = "Goto T[y]pe Definition" })

	map("n", "gi", function() handle_builtins({ operation = vim.lsp.buf.implementation, }) end,
		{ desc = "[G]oto [I]mpl" })

	map("n", "]]", function()
		local cnext_op = function() vim.cmd("cnext") end
		handle_builtins({ operation = cnext_op })
	end, { silent = true, desc = "qf next" })

	map("n", "[[", function()
		local cprev_op = function() vim.cmd("cprev") end
		handle_builtins({ operation = cprev_op })
	end, { silent = true, desc = "qf prev" })

  -- stylua: ignore end
end

